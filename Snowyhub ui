                tween(inputBg, {Position = UDim2.new(orig.X.Scale, orig.X.Offset + 12, orig.Y.Scale, orig.Y.Offset)}, 0.04)
                task.wait(0.04)
                tween(inputBg, {Position = UDim2.new(orig.X.Scale, orig.X.Offset - 12, orig.Y.Scale, orig.Y.Offset)}, 0.04)
                task.wait(0.04)
            end
            tween(inputBg, {Position = orig}, 0.08)
            task.wait(1.5)
            tween(inputStroke, {Color = T.Border, Thickness = 1.5}, 0.3)
            if statusMsg.Text:find(errMsg) then
                statusMsg.Text = "🔑 Enter your key to access the script"
                tween(statusMsg, {TextColor3 = T.Grey}, 0.3)
            end
        end
        isValidating = false
    end)
end)
while not getgenv().SCRIPT_KEY and not getgenv().UI_CLOSED do
    task.wait(0.1)
end
