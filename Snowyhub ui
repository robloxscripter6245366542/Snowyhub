-- SNOW PARTICLE SYSTEM (Fixed pool — no runtime allocation)
-- ══════════════════════════════════════════════════════════════
local snowPool = {}
local SNOW_COUNT = 10  -- Fixed pool size, never allocates more
for i = 1, SNOW_COUNT do
    local sz = math.random(8, 16)
    local flake = Instance.new("TextLabel")
    flake.Size = UDim2.new(0, sz, 0, sz)
    flake.BackgroundTransparency = 1
    flake.Text = "❄"
    flake.TextColor3 = T.White
    flake.TextSize = sz
    flake.ZIndex = 3
    flake.Parent = Screen
    snowPool[i] = {label = flake, active = false, startTime = 0, duration = 0, startX = 0, endX = 0}
end
-- Recycle-based snow loop
task.spawn(function()
    while Screen and Screen.Parent do
        for _, s in ipairs(snowPool) do
            if not s.active then
                -- Reuse this flake
                local dur = math.random(50, 90) / 10
                local startX = math.random() * 0.95 + 0.025
                local drift = math.random(-50, 50)
                s.active = true
                s.label.Position = UDim2.new(startX, 0, -0.05, 0)
                s.label.TextTransparency = math.random(30, 70) / 100
                s.label.Rotation = math.random(0, 360)
                s.label.Visible = true
                tween(s.label, {
                    Position = UDim2.new(startX, drift, 1.08, 0),
                    TextTransparency = 1
                }, dur, Enum.EasingStyle.Linear)
                task.delay(dur, function()
                    s.active = false
                    pcall(function() s.label.Visible = false end)
                end)
                break  -- Only spawn one per loop tick
            end
        end
        task.wait(math.random(8, 20) / 10)  -- Slower spawn rate
    end
end)
