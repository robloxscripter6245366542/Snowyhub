-- DELTA EXECUTOR COMPATIBILITY SHIM
-- ══════════════════════════════════════════════════════════════
-- UI script runs BEFORE the main hub, so it needs its own fallbacks
-- for executor-specific globals. Without this, Delta users get errors
-- on buttons that copy text to clipboard, etc.
pcall(function()
    -- setclipboard: Delta has it but some forks use toclipboard
    if not setclipboard then
        local cb = nil
        if toclipboard then cb = toclipboard
        elseif Clipboard and Clipboard.set then cb = function(s) Clipboard:set(s) end
        else cb = function() end end
        pcall(function() getgenv().setclipboard = cb end)
    end
    -- identifyexecutor: Delta has it on newer builds
    if not identifyexecutor then
        identifyexecutor = function() return "Unknown", "0.0.0" end
        pcall(function() getgenv().identifyexecutor = identifyexecutor end)
    end
    -- gethui: fallback to CoreGui if missing
    if not gethui then
        gethui = function() return game:GetService("CoreGui") end
        pcall(function() getgenv().gethui = gethui end)
    end
    -- request alias for Server Hop / HTTP buttons
    if not request then
        if syn and syn.request then request = syn.request
        elseif http and http.request then request = http.request
        elseif http_request then request = http_request end
        pcall(function() if request then getgenv().request = request end end)
    end
end)
