-- Try (1): SDK was already loaded by Jnkie's protector (preferred path)
if getgenv().Junkie and type(getgenv().Junkie) == "table" then
    Junkie = getgenv().Junkie
end
-- Try (2): Fetch the official SDK ourselves (raw run path)
if not Junkie then
    pcall(function()
        local src = game:HttpGet("https://jnkie.com/sdk/library.lua")
        if src and #src > 50 then
            local fn = loadstring(src)
            if fn then Junkie = fn() end
        end
    end)
end
-- Try (3): Stub fallback so the rest of the script never crashes
if not Junkie or type(Junkie) ~= "table" then
    Junkie = {
        service    = "",
        identifier = "",
        provider   = "Mixed",
        check_key  = function(key) return false, "Jnkie SDK unavailable - try re-running" end,
        get_link   = function() return "https://getsnowy.xyz/pricing" end,
    }
    warn("[SnowyHub] Jnkie SDK unavailable, using stub. Key validation may not work.")
end
