local function createPanel(size, position, zIndex)
    local panel = Instance.new("Frame")
    panel.Size = size
    panel.Position = position
    panel.BackgroundColor3 = T.BgPanel
    panel.BackgroundTransparency = 0.08
    panel.BorderSizePixel = 0
    local zIdx = zIndex or 11
    panel.ZIndex = zIdx
    panel.ClipsDescendants = true
    panel.Parent = mainFrame
    corner(panel, 18)
    -- Inner glow layer (glass effect)
    local glass = Instance.new("Frame")
    glass.Size = UDim2.new(1, 0, 0.4, 0)
    glass.Position = UDim2.new(0, 0, 0, 0)
    glass.BackgroundColor3 = T.White
    glass.BackgroundTransparency = 0.96
    glass.BorderSizePixel = 0
    glass.ZIndex = zIdx + 1
    glass.Parent = panel
    corner(glass, 18)
    gradient(glass, Color3.new(1,1,1), Color3.new(1,1,1), 90)
    -- Border glow
    local s = stroke(panel, T.Accent1, 1.5, 0.55)
    return panel, s
end
