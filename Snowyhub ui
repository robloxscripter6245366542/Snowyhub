-- utf8.char(0x2500) .. utf8.char(0x2500)utf8.char(0x2500) Button Builder with premium hover effects utf8.char(0x2500) .. utf8.char(0x2500)utf8.char(0x2500)
local function createButton(text, pos, size, bgColor, parent, opts)
    opts = opts or {}
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = bgColor
    btn.BackgroundTransparency = opts.bgTransparency or 0.08
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.BorderSizePixel = 0
    btn.ZIndex = 14
    btn.ClipsDescendants = true
    btn.Parent = parent or centerPanel
    corner(btn, 12)
    local btnStroke = stroke(btn, opts.strokeColor or bgColor, opts.strokeThick or 1.5, opts.strokeTrans or 0.35)
    -- Optional inner gradient overlay for depth
    if opts.gradient then
        local innerGrad = Instance.new("Frame")
        innerGrad.Size = UDim2.new(1, 0, 1, 0)
        innerGrad.BackgroundColor3 = Color3.new(1, 1, 1)
        innerGrad.BackgroundTransparency = 0.92
        innerGrad.BorderSizePixel = 0
        innerGrad.ZIndex = 14
        innerGrad.Parent = btn
        corner(innerGrad, 12)
        gradient(innerGrad, opts.gradient[1], opts.gradient[2], opts.gradient[3] or 90)
    end
    -- Button text
    local btnText = Instance.new("TextLabel")
    btnText.Size = UDim2.new(1, -24, 1, 0)
    btnText.Position = UDim2.new(0, 20, 0, 0)
    btnText.BackgroundTransparency = 1
    btnText.Text = text
    btnText.TextColor3 = T.White
    btnText.TextSize = opts.textSize or 13
    btnText.Font = Enum.Font.GothamBold
    btnText.ZIndex = 15
    btnText.Parent = btn

    local btnIcon = Instance.new("ImageLabel")
    btnIcon.Size = UDim2.new(0, 12, 0, 12)
    btnIcon.Position = UDim2.new(0, 8, 0.5, -6)
    btnIcon.BackgroundTransparency = 1
    btnIcon.ZIndex = 16
    btnIcon.Parent = btn
    
    if opts.icon then
        btnIcon.Image = opts.icon
        btnIcon.ImageColor3 = T.White
        btnIcon.Visible = true
    else
        btnIcon.Visible = false
        btnText.Size = UDim2.new(1, 0, 1, 0)
        btnText.Position = UDim2.new(0, 0, 0, 0)
        btnText.TextXAlignment = Enum.TextXAlignment.Center
    end
    
    -- Shimmer sweep + RIPPLE click animation
    local shimmer = Instance.new("Frame")
    shimmer.Size = UDim2.new(0.2, 0, 1, 0)
    shimmer.Position = UDim2.new(-0.25, 0, 0, 0)
    shimmer.BackgroundColor3 = T.White
    shimmer.BackgroundTransparency = 0.82
    shimmer.BorderSizePixel = 0
    shimmer.ZIndex = 16
    shimmer.Parent = btn
    corner(shimmer, 12)
    gradient(shimmer, Color3.new(1,1,1), Color3.fromRGB(200, 230, 255), 0)
    -- Store original values for hover restore
    local origSize = size
    local origPos = pos
    local hoverSize = UDim2.new(origSize.X.Scale, origSize.X.Offset + 8, origSize.Y.Scale, origSize.Y.Offset + 4)
    local hoverPos = UDim2.new(origPos.X.Scale, origPos.X.Offset - 4, origPos.Y.Scale, origPos.Y.Offset - 2)
    btn.MouseEnter:Connect(function()
        tween(btn, {Size = hoverSize, Position = hoverPos, BackgroundTransparency = 0}, 0.2, Enum.EasingStyle.Back)
        tween(btnStroke, {Transparency = 0, Thickness = 2}, 0.15)
        tween(btnText, {TextSize = (opts.textSize or 13) + 1}, 0.15)
        shimmer.Position = UDim2.new(-0.25, 0, 0, 0)
        tween(shimmer, {Position = UDim2.new(1.1, 0, 0, 0)}, 0.4, Enum.EasingStyle.Quad)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, {Size = origSize, Position = origPos, BackgroundTransparency = opts.bgTransparency or 0.08}, 0.25, Enum.EasingStyle.Quint)
        tween(btnStroke, {Transparency = opts.strokeTrans or 0.35, Thickness = opts.strokeThick or 1.5}, 0.2)
        tween(btnText, {TextSize = opts.textSize or 13}, 0.2)
    end)
    btn.MouseButton1Down:Connect(function()
        local pressSize = UDim2.new(origSize.X.Scale, origSize.X.Offset - 4, origSize.Y.Scale, origSize.Y.Offset - 2)
        local pressPos = UDim2.new(origPos.X.Scale, origPos.X.Offset + 2, origSize.Y.Scale, origPos.Y.Offset + 1)
        tween(btn, {Size = pressSize, Position = pressPos}, 0.06)
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, {Size = origSize, Position = origPos}, 0.12, Enum.EasingStyle.Back)
    end)
    -- ✨ Ripple expand on click
    btn.MouseButton1Click:Connect(function()
        local ripple = Instance.new("Frame")
        ripple.Size = UDim2.new(0, 0, 0, 0)
        ripple.Position = UDim2.new(0.5, 0, 0.5, 0)
        ripple.BackgroundColor3 = T.White
        ripple.BackgroundTransparency = 0.6
        ripple.BorderSizePixel = 0
        ripple.ZIndex = 17
        ripple.AnchorPoint = Vector2.new(0.5, 0.5)
        ripple.Parent = btn
        corner(ripple, 50)
        local sz = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.5
        tween(ripple, {
            Size = UDim2.new(0, sz, 0, sz),
            BackgroundTransparency = 1
        }, 0.5, Enum.EasingStyle.Quad)
        task.delay(0.55, function() ripple:Destroy() end)
    end)
    return btn, btnText, btnIcon
end
